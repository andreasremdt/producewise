---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProduceImage from '../../components/ProduceImage.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
export async function getStaticPaths() {
  return (await getCollection('produce')).map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const p = entry.data;
const record = await getEntry(p.nutrition);
if (!record) throw new Error(`Missing nutrition: ${entry.id}`);
const n = record.data;
const story = (await getCollection('stories')).find((s) => s.data.produce.id === entry.id);
const article = story ? await render(story) : undefined;
const Story = article?.Content;
const icons = {
  Refrigerator: 'fridge',
  'Room temperature': 'sun',
  'Cool, dark place': 'box',
  Freezer: 'snow',
};
const defaultStorage = p.storage.find((s) => s.condition === p.defaultCondition)!;
const nutrientNames: Record<string, string> = {
  energy: 'Energy',
  carbohydrate: 'Carbs',
  protein: 'Protein',
  fat: 'Fat',
  fiber: 'Fiber',
  'vitamin-c': 'Vitamin C',
  potassium: 'Potassium',
};
---

<Layout title={`${p.name}: how to store, buy & enjoy`} description={p.description}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/browse/">Produce library</a>
    <Icon name="chevron" size={14} />
    <a href={`/browse/?category=${p.category}`}>
      {p.category === 'fruit' ? 'Fruits' : 'Vegetables'}
    </a>
    <Icon name="chevron" size={14} />
    <span>{p.name}</span>
  </nav>
  <section class="detail-hero" style={`--produce-color:${p.color}`}>
    <figure class="detail-photo">
      <ProduceImage id={entry.id} alt={p.image.alt} eager />
      <figcaption>
        <a href={p.image.source}>Photo: {p.image.author}</a> ·{' '}
        <a
          href={p.image.license.startsWith('GFDL') ? '/licenses/gfdl-1.2.txt' : p.image.licenseUrl}
        >
          {p.image.license}
        </a>
      </figcaption>
    </figure>
    <div class="detail-intro">
      <span class="eyebrow">A LITTLE GUIDE TO</span>
      <h1>
        {p.name}
        <span>.</span>
      </h1>
      <p>{p.description}</p>
      <div class="detail-tags">
        <span>{p.category === 'fruit' ? 'Fruit' : 'Vegetable'}</span>
        {p.tags.map((t) => (
          <span>{t}</span>
        ))}
      </div>
      <div class="detail-actions">
        <FavoriteButton id={entry.id} name={p.name} full />
        <span class="offline-status" data-offline-status={entry.id}></span>
      </div>
      <a href="#storage" class="text-link">
        Straight to storage <span>↓</span>
      </a>
    </div>
  </section>
  <div class="detail-layout">
    <div class="detail-main">
      <section class="storage-section" id="storage">
        <div class="section-heading">
          <div>
            <span class="eyebrow">FIRST THINGS FIRST</span>
            <h2>Give it the right home.</h2>
          </div>
          <Icon name="box" size={25} />
        </div>
        <p class="storage-lead">
          For <span data-storage-label>{defaultStorage.label.toLowerCase()}</span>{' '}
          {p.name.toLowerCase()}:{' '}
          <strong data-storage-value>
            {defaultStorage.location.toLowerCase()} · {defaultStorage.time.toLowerCase()}
          </strong>
        </p>
        {p.storage.length > 1 && (
          <div class="condition-picker">
            <span>How is yours?</span>
            <div class="condition-buttons" role="group" aria-label="Produce condition">
              {p.storage.map((s) => (
                <button
                  data-condition={s.condition}
                  aria-controls={`storage-${s.condition}`}
                  aria-pressed={s.condition === p.defaultCondition ? 'true' : 'false'}
                >
                  {s.label}
                </button>
              ))}
            </div>
          </div>
        )}
        <div data-storage-panels data-default={p.defaultCondition}>
          {p.storage.map((s) => (
            <div
              class="storage-panel"
              id={`storage-${s.condition}`}
              data-panel={s.condition}
              data-label={s.label}
              data-location={s.location}
              data-time={s.time}
            >
              <h3 class="condition-heading">
                {s.label} {p.name.toLowerCase()}
              </h3>
              <div class="storage-summary">
                <div>
                  <span class="storage-symbol">
                    <Icon name={icons[s.location]} size={26} />
                  </span>
                  <span class="summary-label">KEEP IT HERE</span>
                  <strong>{s.location}</strong>
                </div>
                <div>
                  <span class="storage-symbol">
                    <Icon name="clock" size={26} />
                  </span>
                  <span class="summary-label">APPROXIMATE KEEPING TIME</span>
                  <strong>{s.time}</strong>
                </div>
              </div>
              <h3>{s.preparation}</h3>
              <p>{s.advice}</p>
              <div class="caution">
                <Icon name="info" size={18} />
                <p>{s.caution}</p>
              </div>
              <p class="advice-citations">
                Based on{' '}
                {s.sourceIds.map((id, i) => (
                  <>
                    <a href={`#source-${id}`}>
                      {p.sources.find((x) => x.id === id)?.title.split(' · ')[0]}
                    </a>
                    {i < s.sourceIds.length - 1 ? ' · ' : ''}
                  </>
                ))}
              </p>
            </div>
          ))}
        </div>
        {p.mistakes?.length && (
          <div class="freshness-note">
            <h3>Mistakes to avoid</h3>
            <ul>
              {p.mistakes.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        )}
        <p class="estimate-note">
          A guide to quality, not a safety deadline. Variety, ripeness, temperature, and handling
          all affect keeping time.
        </p>
      </section>
      <section class="guide-section" id="buying">
        <span class="eyebrow">AT THE MARKET</span>
        <h2>Pick a good one.</h2>
        {p.ripeness?.length && (
          <ul>
            {p.ripeness.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        )}
        <ul class="check-list">
          {p.buying.map((t) => (
            <li>
              <Icon name="check" size={18} />
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <div class="freshness-note">
          <h3>Freshness check</h3>
          <p>{p.freshness}</p>
          <a href="#sources" class="text-link">
            See the guidance <Icon name="arrow" size={14} />
          </a>
        </div>
        {p.together && (
          <>
            <h3>Good neighbors</h3>
            <p>{p.together}</p>
          </>
        )}
      </section>
      {(p.freezing || p.leftovers?.length) && (
        <section class="guide-section" id="use-it">
          <span class="eyebrow">MAKE EVERY BIT COUNT</span>
          <h2>A little left? Lots of possibility.</h2>
          <div class="two-up">
            {p.freezing && (
              <div class="info-card">
                <Icon name="snow" size={24} />
                <h3>Save some for later</h3>
                <p>{p.freezing.instructions}</p>
                <p class="muted">{p.freezing.quality}</p>
                <a
                  class="text-link"
                  href={p.sources.find((s) => s.id === p.freezing!.sourceId)?.url}
                >
                  Full freezing instructions <Icon name="arrow" size={14} />
                </a>
              </div>
            )}
            {p.leftovers?.length && (
              <div class="info-card warm">
                <Icon name="spark" size={24} />
                <h3>A little kitchen inspiration</h3>
                <ul>
                  {p.leftovers.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                <small>Ideas for sound produce, before it spoils.</small>
              </div>
            )}
          </div>
        </section>
      )}
      <section class="guide-section" id="nutrition">
        <span class="eyebrow">THE GOOD STUFF INSIDE</span>
        <h2>A closer look at nutrition.</h2>
        <p class="nutrition-basis">Typical values per 100 g, {n.preparation}.</p>
        <div class="nutrition-grid">
          {n.nutrients.map((v) => (
            <div class="nutrient">
              <span>{nutrientNames[v.key]}</span>
              <strong>
                {v.value === null
                  ? '—'
                  : new Intl.NumberFormat('en', {
                      maximumFractionDigits: v.unit === 'kcal' ? 0 : 1,
                    }).format(v.value)}
                {v.value !== null && <small>{v.unit}</small>}
              </strong>
              {v.value === null && <small>Unavailable</small>}
            </div>
          ))}
        </div>
        <p class="nutrition-footnote">
          Representative estimates from one USDA record. “—” means unavailable, never zero. The
          condition selector does not change this food form.
        </p>
        <details class="source-details">
          <summary>
            View the nutrition source <Icon name="chevron" size={16} />
          </summary>
          <dl>
            <div>
              <dt>Provider</dt>
              <dd>{n.provider}</dd>
            </div>
            <div>
              <dt>Record</dt>
              <dd>
                <a href={n.sourceUrl}>
                  {n.fdcId} · {n.dataType}
                </a>
              </dd>
            </div>
            <div>
              <dt>Exact description</dt>
              <dd>{n.description}</dd>
            </div>
            <div>
              <dt>Basis</dt>
              <dd>{n.basis}</dd>
            </div>
            <div>
              <dt>Published</dt>
              <dd>{n.publicationDate}</dd>
            </div>
            <div>
              <dt>Imported</dt>
              <dd>{n.importedAt.slice(0, 10)}</dd>
            </div>
            <div>
              <dt>Source checked</dt>
              <dd>{n.reviewedAt}</dd>
            </div>
          </dl>
          <p>{n.selectionReason}</p>
          <p>
            Energy uses the record’s Atwater specific value when available, then reported energy,
            then Atwater general. No values are combined across foods.
          </p>
        </details>
      </section>
      {p.tips?.length && (
        <section class="guide-section">
          <span class="eyebrow">SMALL THINGS, BIG DIFFERENCE</span>
          <h2>A little extra know-how.</h2>
          <ul>
            {p.tips.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>
      )}
      {p.funFacts?.length && (
        <section class="guide-section">
          <h2>Did you know?</h2>
          <ul>
            {p.funFacts.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>
      )}
      {Story && story && (
        <section class="guide-section editorial">
          <h2>{story.data.title}</h2>
          <Story />
          {story.data.sources.map((s) => (
            <p>
              <a href={s.url}>{s.title}</a>
            </p>
          ))}
        </section>
      )}
      <section class="guide-section sources-section" id="sources">
        <span class="eyebrow">GOOD ADVICE HAS ROOTS</span>
        <h2>Sources & a little transparency.</h2>
        <p>
          Source-checked{' '}
          {new Date(p.reviewedAt + 'T12:00:00Z').toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })}
          . Initial editorial review is AI-assisted; this is not an independent expert
          certification.
        </p>
        <ul>
          {p.sources.map((s) => (
            <li id={`source-${s.id}`}>
              <a href={s.url}>
                {s.title} <span>↗</span>
              </a>
              <small>{s.supports}</small>
            </li>
          ))}
          <li>
            <a href={n.sourceUrl}>USDA FoodData Central · {n.description} ↗</a>
            <small>Nutrition, per 100 g edible portion</small>
          </li>
        </ul>
        <p class="image-attribution">
          Photography: <a href={p.image.source}>{p.image.author}</a>,{' '}
          <a href={p.image.licenseUrl}>{p.image.license}</a>. {p.image.modifications} Adapted images
          retain their source license.{' '}
          {p.image.license.startsWith('GFDL') && (
            <a href="/licenses/gfdl-1.2.txt">Read the full GNU FDL 1.2 license.</a>
          )}
        </p>
      </section>
    </div>
    <aside class="guide-sidebar">
      <div class="guide-jump">
        <span class="eyebrow">IN THIS GUIDE</span>
        <a href="#storage">
          <Icon name="box" size={17} />
          Storage essentials
        </a>
        <a href="#buying">
          <Icon name="check" size={17} />
          Buying & freshness
        </a>
        <a href="#use-it">
          <Icon name="snow" size={17} />
          Freezing & leftovers
        </a>
        <a href="#nutrition">
          <Icon name="leaf" size={17} />
          Nutrition
        </a>
        <a href="#sources">
          <Icon name="book" size={17} />
          Sources
        </a>
      </div>
      <div class="safety-card">
        <Icon name="leaf" size={24} />
        <h3>A fresh start.</h3>
        <p>
          Rinse produce under running water before preparing. Keep your fridge at 4°C / 40°F or
          below. Refrigerate pre-cut produce.
        </p>
        <a href="https://www.fda.gov/food/buy-store-serve-safe-food/selecting-and-serving-produce-safely">
          FDA produce guidance ↗
        </a>
      </div>
    </aside>
  </div>
</Layout>
